[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"
PIPENV_VENV_IN_PROJECT = 1

[scripts]
dev = "uvicorn main:app --reload"
start = "uvicorn main:app"
test = "pytest"
coverage = "pytest --cov --cov-report=term-missing --cov-report=xml --cov-report=json"
lint = "ruff ."

[packages]
fastapi = "==0.162.0"
pillow = "==13.0.0"
requests = "==2.34.2"
uvicorn = {extras = ["standard"], version = "*"}
pytest = "==9.2.0"
pytest-cov = "==7.1.0"
httpx = "==0.28.1"
ruff = "==0.17.3"
fastapi-analytics = "==1.2.5"
python-dotenv = "==1.2.4"
pydantic-settings = "==2.16.2"

[dev-packages]

[requires]
python_version = "3" # >=3.11 required
# TODO: Change this to minimum >=3.9 if pipenv ever starts supporting minimum python version

