{
    "name": "markdown-videos",
    "private": true,
    "version": "0.3.0",
    "packageManager": "pnpm@9.0.6",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "turbo run build",
        "api:install": "turbo run api:install",
        "dev": "turbo dev --parallel",
        "start": "turbo start --parallel",
        "preview": "turbo preview --parallel",
        "test": "turbo run test",
        "test:verbose": "turbo run test:verbose",
        "test:coverage": "turbo run test:coverage",
        "lint": "turbo run lint",
        "clean:workspaces": "turbo clean",
        "version:bump": "node scripts/bump-version.mjs",
        "version:check": "node scripts/check-version.mjs origin/main",
        "changelog": "node scripts/changelog.mjs"
    },
    "devDependencies": {
        "dotenv-cli": "^8.0.0",
        "turbo": "^2.5.0"
    }
}
